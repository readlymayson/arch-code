[Unit]
Description=Arch-Code Worker (Public) — RQ-воркер клиентских задач (coding_tasks, Redis db 1)
After=network.target redis-server.service
Wants=redis-server.service
BindsTo=redis-server.service

# Защита от бесконечного цикла перезапусков
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/projects/arch-code
Environment=PYTHONPATH=/home/dev/projects/arch-code
Environment=PATH=/home/dev/projects/arch-code/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Публичный инстанс AI Core работает на Redis DB 1 (config.public.json).
# Этот воркер выполняет ТОЛЬКО клиентские задачи из db 1 — полная изоляция
# от личного инстанса (db 0, arch-code-worker.service).
Environment=REDIS_URL=redis://localhost:6379/1
Environment=REDIS_DB=1
ExecStart=/home/dev/projects/arch-code/venv/bin/python /home/dev/projects/arch-code/rq_worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arch-code-worker-public

# Безопасность
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# Лимиты
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
