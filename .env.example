# ═══════════════════════════════════════════════════════════════
#  arch-code — переменные окружения (копия для настройки)
#  Скопируйте в .env и заполните значения.
# ═══════════════════════════════════════════════════════════════

# ── LLM (RouterAI / DeepSeek V4 Flash) ─────────────────────────
# Ключ API RouterAI. Получить: https://platform.deepseek.com/api_keys
ROUTERAI_API_KEY=sk-ваш_ключ_здесь

# Базовый URL RouterAI (OpenAI-совместимый)
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Таймаут одного LLM-вызова (сек). RouterAI иногда отвечает медленно.
ARCH_CODE_LLM_TIMEOUT=120

# ── Redis (RQ-воркер) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Альтернатива — отдельные параметры:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ── Run Verifier (smoke-проверка приложения) ───────────────────
# Health-check по умолчанию для web_app
HEALTH_ENDPOINT=/health
HEALTH_PORT=8000

# ── Docker ─────────────────────────────────────────────────────
# (опционально) Реестр Docker-образов для sandbox
# SANDBOX_PYTHON_IMAGE=python:3.12-slim
# SANDBOX_NODE_IMAGE=node:alpine

# ── Алертинг (опционально) ─────────────────────────────────────
# Webhook для уведомлений об ошибках задач (Telegram/прочее)
# ERROR_WEBHOOK_URL=
